{
  "input": {
    "required": [
      {
        "name": "target_host",
        "type": "host_ref",
        "from": "runtime"
      },
      {
        "name": "ssh_user",
        "type": "string",
        "from": "runtime"
      }
    ],
    "optional": [
      {
        "name": "private_key_path",
        "type": "path",
        "from": "config",
        "desc": "执行点私钥路径；省略时按执行点家目录解析（$HOME/.ssh/agv_session），不存在则生成"
      },
      {
        "name": "public_key",
        "type": "string",
        "from": "config",
        "desc": "显式公钥；默认读 <private_key_path>.pub"
      },
      {
        "name": "port",
        "type": "port",
        "from": "config",
        "desc": "redis 端口，默认 6379"
      },
      {
        "name": "ssh_port",
        "type": "port",
        "from": "config",
        "desc": "SSH 端口，默认 22"
      },
      {
        "name": "authorized_keys_dir",
        "type": "path",
        "from": "config",
        "desc": "默认 /root/.ssh"
      },
      {
        "name": "authorized_keys_file",
        "type": "string",
        "from": "config",
        "desc": "默认 authorized_keys"
      },
      {
        "name": "redis_key",
        "type": "string",
        "from": "config",
        "desc": "redis 里承载公钥的 key 名，默认 agv_session_key"
      }
    ]
  },
  "judge": "uid0_when_node_requires_root"
}
