{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "V1 OutputNode (1.1.0: AND action or terminal OR goal)",
  "type": "object",
  "required": ["id", "type", "description", "rule_desc", "attack_id", "source_host", "target_host", "service", "protocol", "port", "vulnerability", "dependencies"],
  "additionalProperties": false,
  "properties": {
    "id": {"$ref": "#/$defs/node_id"},
    "type": {"enum": ["AND", "OR"]},
    "description": {"type": "string"},
    "rule_desc": {"type": ["string", "null"]},
    "attack_id": {"type": ["string", "null"], "pattern": "^T[0-9]{4}([.][0-9]{3})?$"},
    "source_host": {"type": ["string", "null"]},
    "target_host": {"type": ["string", "null"]},
    "service": {"type": ["string", "null"]},
    "protocol": {"type": ["string", "null"]},
    "port": {"type": ["string", "null"]},
    "vulnerability": {"type": ["string", "null"]},
    "dependencies": {"type": "array", "items": {"$ref": "#/$defs/dependency"}}
  },
  "$defs": {
    "node_id": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$"},
    "dependency": {
      "oneOf": [
        {"type": "object", "required": ["ref", "type", "description", "validation"], "additionalProperties": false,
         "properties": {"ref": {"$ref": "#/$defs/node_id"}, "type": {"const": "LEAF"}, "description": {"type": "string"},
                        "validation": {"type": "object", "required": ["kind", "fields"], "additionalProperties": false,
                                       "properties": {"kind": {"enum": ["network_reachability", "service_exposure", "credential", "capability", "environment_fact", "mount_share", "unknown"]},
                                                      "fields": {"type": "object"}}}}},
        {"type": "object", "required": ["ref", "type", "description", "produced_by"], "additionalProperties": false,
         "properties": {"ref": {"$ref": "#/$defs/node_id"}, "type": {"const": "OR"}, "description": {"type": "string"},
                        "produced_by": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/node_id"}}}},
        {"type": "object", "required": ["ref", "type", "description"], "additionalProperties": false,
         "properties": {"ref": {"$ref": "#/$defs/node_id"}, "type": {"const": "AND"}, "description": {"type": "string"}}}
      ]
    }
  }
}
